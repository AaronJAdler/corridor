# One line-ending convention everywhere, so files built into a Linux image from a Windows
# checkout are identical to those built on Linux.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.pdf binary
uv.lock linguist-generated=true

# Shell scripts run inside Linux containers, whatever the checkout's platform: a carriage
# return at the end of a line breaks them. Stated outright, so that it holds even if the
# rule above is ever relaxed.
*.sh text eol=lf

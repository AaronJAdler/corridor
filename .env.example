# Settings for the local stack in compose.yaml. Copy this file to .env and replace every
# value: the ones here are placeholders that are long enough to start with and protect
# nothing. .env is ignored by git and by the image build.
#
# A random value for any of the secrets below:
#
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The passwords go into connection URLs as they are, so keep to letters, digits, "-" and
# "_", which is what that command prints.

# --- PostgreSQL ------------------------------------------------------------------------
# The superuser of the database container, the role that owns the schema and runs
# migrations, and the role the API and the worker connect as.
POSTGRES_PASSWORD=placeholder-postgres-superuser-password  # pragma: allowlist secret
DB_OWNER_PASSWORD=placeholder-schema-owner-password-0000  # pragma: allowlist secret
DB_APP_PASSWORD=placeholder-application-password-00000  # pragma: allowlist secret

# --- Access tokens ---------------------------------------------------------------------
# The signing key is a file, not a value. Generate one with
#
#   uv run corridor keys generate --out .local/keys
#
# and put the name of the private key it wrote (<key id>.pem) here. The directory is
# mounted read-only into the API container.
JWT_SIGNING_KEY_FILE=replace-with-the-key-id.pem

# --- Corridor's own keys ---------------------------------------------------------------
# What agent API keys are hashed under, and what authenticates the rates cached in Redis.
# At least 32 characters each.
API_KEY_HASH_KEY=placeholder-agent-key-hash-key-000000000  # pragma: allowlist secret
FX_CACHE_MAC_KEY=placeholder-fx-cache-mac-key-00000000000  # pragma: allowlist secret

# --- The simulated providers -----------------------------------------------------------
# The key Corridor presents to the simulator, the secrets the simulator signs its webhooks
# with, and the token its control endpoints ask for. At least 32 characters each.
PROVIDER_API_KEY=placeholder-provider-api-key-000000000000  # pragma: allowlist secret
BANK_WEBHOOK_SECRET=placeholder-bank-webhook-secret-00000000  # pragma: allowlist secret
CUSTODY_WEBHOOK_SECRET=placeholder-custody-webhook-secret-00000  # pragma: allowlist secret
SIM_CONTROL_TOKEN=placeholder-simulator-control-token-0000  # pragma: allowlist secret

# --- Where the API is published --------------------------------------------------------
# On this machine only: http://127.0.0.1:8000
API_PORT=8000
